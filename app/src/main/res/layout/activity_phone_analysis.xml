<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_nav_chip"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="本机端分析"
            android:textColor="@color/primary_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/analysisTitle"
            style="@style/PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="正在提取生理信号"
            android:textSize="23sp" />

        <TextView
            android:id="@+id/analysisSubtitle"
            style="@style/PageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="人脸视频仅在本机处理，正在运行 EfficientPhys 深度学习模型。" />

        <ProgressBar
            android:id="@+id/analysisProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="24dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="3"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/line" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="horizontal">
            <TextView android:id="@+id/stageFace" android:layout_width="0dp" android:layout_height="76dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_metric_primary" android:gravity="center" android:text="01\n人脸定位" android:textColor="@color/primary_dark" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/stageSignal" android:layout_width="0dp" android:layout_height="76dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_metric_blue" android:gravity="center" android:text="02\n模型推理" android:textColor="@color/muted" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/stageEstimate" android:layout_width="0dp" android:layout_height="76dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_metric_amber" android:gravity="center" android:text="03\n质量评估" android:textColor="@color/muted" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/analysisFrameStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="请保持此页面开启，完成后将自动进入结果页" android:textColor="@color/muted" android:textSize="12sp" />

        <LinearLayout android:id="@+id/analysisFailureActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:visibility="gone">
            <Button android:id="@+id/retryAnalysisButton" style="@style/PrimaryAction" android:layout_width="match_parent" android:layout_height="52dp" android:text="重新分析" />
            <Button android:id="@+id/reRecordButton" style="@style/SecondaryAction" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="9dp" android:text="重新录制" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
