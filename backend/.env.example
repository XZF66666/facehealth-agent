APP_NAME=FaceHealth Agent Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO

# OpenAI-compatible model service. Keep the real key only in .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.3
AUTH_REQUIRED=false

# Aliyun Model Studio example (Beijing public endpoint):
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=configure-locally-do-not-commit

DATABASE_PATH=./data/conversations.db
MAX_HISTORY_MESSAGES=12
